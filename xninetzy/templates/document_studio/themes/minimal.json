{
  "name": "minimal",
  "description": "Quiet monochrome style: Arial, gray accents, no cover, generous whitespace.",
  "fonts": {
    "body": "Arial",
    "heading": "Arial",
    "mono": "DejaVu Sans Mono",
    "deck_body": null,
    "deck_heading": null
  },
  "sizes": {
    "body": 11,
    "small": 9,
    "title": 28,
    "subtitle": 16,
    "h1": 18.0,
    "h2": 14.0,
    "h3": 12.0,
    "slide_title": 30,
    "slide_body": 20,
    "slide_min": 14
  },
  "colors": {
    "text": "#222222",
    "heading": "#111111",
    "accent": "#444444",
    "muted": "#777777",
    "table_header_bg": "#F2F2F2",
    "table_header_text": "#111111",
    "table_stripe": "#FAFAFA",
    "slide_background": "#FFFFFF",
    "slide_title": "#111111",
    "slide_text": "#222222"
  },
  "page": {
    "size": "A4",
