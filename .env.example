# Flaz OpenAI-compatible LLM provider
# Never commit the real API key. Put it only in the local .env file.
# Safe prompt: cd services/ai && uv run python scripts/configure_flaz.py
FLAZ_API_KEY=
FLAZ_BASE_URL=https://ai.flaz.id/v1
FLAZ_MODEL=deepseek-v4-pro
FLAZ_TIMEOUT_SECONDS=120
FLAZ_MAX_RETRIES=2

# Host identity used by the AI container for shared data/vault ownership.
# Check with: id -u && id -g
HOST_UID=1000
HOST_GID=1000

# Chat provider registry (comma-separated allowlist)
LLM_DEFAULT_PROVIDER=flaz
LLM_ENABLED_PROVIDERS=flaz
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
FLAZ_MODELS=deepseek-v4-pro

# Optional providers. Enable a provider only after configuring its model and credential.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_MODELS=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MODELS=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_MODELS=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=
OLLAMA_MODELS=
GENERIC_OPENAI_API_KEY=
GENERIC_OPENAI_BASE_URL=
GENERIC_OPENAI_MODEL=
GENERIC_OPENAI_MODELS=

# Optional local coding agents. Keep disabled in Docker unless CLI binaries/auth are mounted.
CODING_AGENT_ENABLED=false
CODING_AGENT_DEFAULT=internal
CODING_AGENT_ALLOWED=internal,codex,claude-code,opencode
CODING_AGENT_ADMIN_ONLY=true
CODING_AGENT_WORKSPACE=.
CODING_AGENT_ALLOWED_ROOT=.
CODING_AGENT_TIMEOUT_SECONDS=600
CODING_AGENT_MAX_OUTPUT_CHARS=12000
CODING_AGENT_SANDBOX=workspace-write
CODING_AGENT_REQUIRE_XNINETZY_MCP=true
CODING_AGENT_MCP_SERVER_NAME=xninetzy
CODING_AGENT_MCP_PREFLIGHT_TIMEOUT_SECONDS=15
# Only these host variables are inherited by coding-agent subprocesses.
# Add a credential variable only when the selected CLI cannot use its own login store.
CODING_AGENT_ENV_ALLOWLIST=PATH,HOME,USER,LOGNAME,LANG,LC_ALL,TERM,TMPDIR,XDG_CONFIG_HOME,XDG_DATA_HOME,XDG_CACHE_HOME,SSL_CERT_FILE,SSL_CERT_DIR,CODEX_HOME
CODEX_BIN=codex
CODEX_MODEL=
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_MODEL=
OPENCODE_BIN=opencode
OPENCODE_MODEL=

# AI FastAPI
AI_API_HOST=0.0.0.0
AI_API_PORT=8000
# Required for WA engine, CLI, reminders API, and debug API.
AI_API_KEY=
AI_API_AUTH_REQUIRED=true
AGENT_DEBUG_ENDPOINTS=false
SINGLE_OWNER_MODE=true
# Optional comma-separated extra owner identities, including a Baileys @lid ID.
OWNER_ALLOWED_JIDS=
DATA_DIR=/app/data
SQLITE_PATH=/app/data/xninetzy.sqlite3
BACKUP_DIR=/app/data/backups
BACKUP_RETENTION=14

# Standard Xninetzy MCP runtime (Codex / Claude Code / OpenCode)
# auto keeps /app paths in Docker and maps them to services/ai/data on the host.
MCP_RUNTIME_MODE=auto
# Optional absolute host overrides; leave blank for repository defaults.
MCP_HOST_DATA_DIR=
MCP_HOST_SQLITE_PATH=
# Optional trusted owner identity for local MCP clients. Blank values fall back
# to ADMIN_JID, BOT_OWNER, and a stable local-owner namespace.
MCP_PRINCIPAL_ID=
MCP_PRINCIPAL_NAME=
MCP_DEFAULT_CHAT_ID=

# OCR for WhatsApp images and scanned PDFs
OCR_ENABLED=true
OCR_LANGUAGES=eng+ind
OCR_MAX_PDF_PAGES=20
OCR_MAX_IMAGE_PIXELS=25000000

# Local Web Analysis: one owner profile per installation, no cloud/multi-tenant service.
WEB_ANALYSIS_ENABLED=true
WEB_ANALYSIS_DATA_DIR=/app/data/web-analysis
WEB_ANALYSIS_PROFILE_ID=local-owner
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEB_ANALYSIS_ENCRYPTION_KEY=
WEB_ANALYSIS_HEADLESS=true
# Enable only after manual headed-browser login has saved an encrypted session.
WEB_ANALYSIS_AUTHENTICATED_CRAWL_ENABLED=false
WEB_ANALYSIS_DEFAULT_TTL_DAYS=14
WEB_ANALYSIS_MAX_PAGES=10
WEB_ANALYSIS_TIMEOUT_MS=30000
WEB_ANALYSIS_REQUEST_DELAY_SECONDS=2
WEB_ANALYSIS_LOCK_STALE_SECONDS=1800
WEB_ANALYSIS_MAX_ENCRYPTED_JSON_BYTES=5242880
WEB_ANALYSIS_BACKGROUND_ENABLED=true
WEB_ANALYSIS_BACKGROUND_INTERVAL_MINUTES=360
WEB_ANALYSIS_BACKGROUND_SITES=hebat,mahasiswa
WEB_ANALYSIS_BACKGROUND_AUTHENTICATED=false

# Skills
SKILLS_ENABLED=true
SKILL_DEBUG_ENDPOINTS=true

# Obsidian
OBSIDIAN_ENABLED=true
OBSIDIAN_VAULT_HOST_PATH=/absolute/path/to/obsidian-vault
OBSIDIAN_VAULT_PATH=/app/obsidian-vault
OBSIDIAN_ALLOW_WRITE=true
OBSIDIAN_ALLOW_DELETE=false
OBSIDIAN_BACKUP_BEFORE_WRITE=true
OBSIDIAN_MAX_FILE_SIZE_MB=5

# Reminder
REMINDER_ENABLED=true
APP_TIMEZONE=Asia/Jakarta
REMINDER_POLL_INTERVAL_SECONDS=30
REMINDER_SCHEDULER_INTERVAL_SECONDS=30
REMINDER_EXPIRE_AFTER_HOURS=24
REMINDER_AUTO_CREATE_ENABLED=true
REMINDER_DEFAULT_TIMEZONE=Asia/Jakarta
WA_MCP_BASE_URL=http://127.0.0.1:8081
WA_MCP_API_KEY=

# Workflow
WORKFLOW_ENABLED=true
WORKFLOW_REQUIRE_CONFIRMATION=true

# WhatsApp Worker
WA_AUTH_DIR=/app/sessions
WA_SESSION_DIR=/app/sessions
WA_LOGIN_MODE=qr
WA_PHONE_NUMBER=
WA_CONNECT_TIMEOUT_MS=60000
WA_QUERY_TIMEOUT_MS=60000
WA_KEEP_ALIVE_INTERVAL_MS=30000
WA_PAIRING_WAIT_MS=90000
WA_PAIRING_RECONNECT_DELAY_MS=30000
WA_GROUP_TRIGGER_MODE=mention_or_prefix
WA_COMMAND_PREFIX=!
WA_GROUP_ALLOW_ALL=false
WA_GROUP_TREAT_ANY_MENTION_AS_BOT=true
WA_LOG_LEVEL=debug
WA_BAILEYS_LOG_LEVEL=warn
WA_MEDIA_DIR=/app/data/wa-media
WA_MEDIA_MAX_BYTES=26214400
WA_PROCESSING_DIR=/app/sessions/processing
WA_MESSAGE_LEASE_MS=300000
WA_MESSAGE_RETRY_DELAY_MS=60000
WA_MESSAGE_RETENTION=5000
AI_BASE_URL=http://127.0.0.1:8000
AI_CHAT_ENDPOINT=/api/chat
AI_TIMEOUT_MS=120000
AI_API_URL=http://127.0.0.1:8000

# Terminal client
XNINETZY_AI_URL=http://127.0.0.1:8000
XNINETZY_CLI_CHAT_ID=xninetzy-cli
XNINETZY_CLI_SENDER_ID=cli-user
XNINETZY_CLI_SENDER_NAME=CLI User
XNINETZY_CLI_TIMEOUT_MS=120000
MCP_SERVER_ENABLED=true
MCP_HOST=0.0.0.0
MCP_PORT=8081
MCP_API_KEY=

# Bot Identity
BOT_NAME=Xninetzy AI
BOT_OWNER=Your Name

# Admin / Deep Research
ADMIN_JID=
ADMIN_NAMES=your_name
DEEP_RESEARCH_ADMIN_ONLY=true
DEEP_RESEARCH_ALLOW_GROUP_ADMINS=true
DEEP_RESEARCH_ALLOW_ADMIN_NAMES=true

# HITL Approval
HITL_ENABLED=true
HITL_REQUIRE_FOR_RESEARCH_SAVE=true
HITL_REQUIRE_FOR_ROADMAP_ACTIVATION=true
HITL_REQUIRE_FOR_HEBAT_UPLOAD=true
HITL_REQUIRE_FOR_BULK_TASK_CREATE=true
HITL_REQUIRE_FOR_OBSIDIAN_WRITE=false
HITL_REQUIRE_FOR_GRAPH_RAG_WRITE=true

# HEBAT / E-Learning UNAIR
HEBAT_BASE_URL=https://hebat.elearning.unair.ac.id
HEBAT_LOGIN_URL=https://hebat.elearning.unair.ac.id/login/index.php
HEBAT_DATA_DIR=/app/data/hebat
HEBAT_DOWNLOAD_DIR=/app/data/hebat/downloads
HEBAT_BROWSER_HEADLESS=true
HEBAT_ALLOW_AUTO_SUBMIT=false
HEBAT_REQUIRE_CONFIRMATION=true
HEBAT_MAX_UPLOAD_BYTES=5242880
HEBAT_SYNC_INTERVAL_MINUTES=60
HEBAT_REMINDER_BEFORE_HOURS=24,6,1
HEBAT_ALLOWED_FILE_TYPES=.pdf
HEBAT_RATE_LIMIT_SECONDS=2.0
HEBAT_USERNAME=
HEBAT_PASSWORD=
HEBAT_NOTIFY_CHAT_ID=
HEBAT_AUTO_LOGIN=false
