---
import SiteHeader from '../components/SiteHeader.astro';
import MobileNavigation from '../components/MobileNavigation.astro';
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  image?: string;
};

const {
  title = 'Xninetzy — Personal Learning OS',
  description = 'Dokumentasi Xninetzy: AI agent WhatsApp, Obsidian, HEBAT, MCP, dan coding agents.',
  image = '/og.svg'
} = Astro.props;

const pageTitle = title.includes('Xninetzy') ? title : `${title} · Xninetzy Docs`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#020008" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="space-field" aria-hidden="true"></div>
    <SiteHeader />
    <MobileNavigation />
    <slot />
    <footer class="site-footer">
      <span>XNINETZY / PERSONAL LEARNING OS</span>
      <p>Build knowledge. Keep agency.</p>
    </footer>
  </body>
</html>
