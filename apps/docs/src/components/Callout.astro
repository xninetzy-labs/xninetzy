---
type Props = {
  type?: 'note' | 'tip' | 'info' | 'warning' | 'danger';
  title?: string;
};
const { type = 'note', title } = Astro.props;

const defaults: Record<string, string> = {
  note: 'Note',
  tip: 'Tip',
  info: 'Info',
  warning: 'Warning',
  danger: 'Danger'
};

const icons: Record<string, string> = {
  note: 'M12 8v4l3 3M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  tip: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  info: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  warning: 'M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z',
  danger: 'M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z'
};

const heading = title ?? defaults[type];
---

<aside class:list={['callout', type]} role={type === 'danger' || type === 'warning' ? 'alert' : 'note'}>
  <header>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d={icons[type]} />
    </svg>
    <strong>{heading}</strong>
  </header>
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    margin: 1.4rem 0;
    border-radius: .65rem;
    border: 1px solid var(--border-dim, #2e1065);
    background: var(--surface, #05010f);
    overflow: hidden;
  }
  .callout header {
    display: flex;
    align-items: center;
    gap: .55rem;
    padding: .65rem .9rem;
    font: 600 .72rem var(--font-mono, ui-monospace, monospace);
    letter-spacing: .14em;
    text-transform: uppercase;
    border-bottom: 1px solid currentColor;
  }
  .callout header svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }
  .callout-body {
    padding: .85rem .95rem;
    font-size: .92rem;
    line-height: 1.6;
    color: var(--text, #fff);
  }
  .callout-body :global(p) {
    margin: 0;
  }
  .callout-body :global(p + p) {
    margin-top: .65rem;
  }
  .callout-body :global(code) {
    background: var(--surface-raised, #0a0417);
    padding: .1em .35em;
    border-radius: .25rem;
    font-size: .85em;
  }
  .callout-body :global(a) {
    color: var(--purple-bright, #c084fc);
  }

  .note    { color: var(--purple-bright, #c084fc); border-color: rgba(139,92,246,.32); }
  .note header { background: rgba(139,92,246,.08); }

  .tip     { color: #34d399; border-color: rgba(52,211,153,.32); }
  .tip header  { background: rgba(52,211,153,.08); }

  .info    { color: var(--purple-bright, #c084fc); border-color: rgba(139,92,246,.32); }
  .info header { background: rgba(139,92,246,.08); }

  .warning { color: var(--orange-bright, #fb923c); border-color: rgba(249,115,22,.32); }
  .warning header { background: rgba(249,115,22,.08); }

  .danger  { color: #f87171; border-color: rgba(248,113,113,.42); }
  .danger header  { background: rgba(248,113,113,.1); }
</style>
