---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { navigation } from '../data/navigation';

const capabilities = [
  { number: '01', title: 'WhatsApp native', text: 'Chat, media, group, reminder, dan command dalam satu antarmuka yang selalu dekat.' },
  { number: '02', title: 'Knowledge connected', text: 'Obsidian, FAISS, Graph RAG, HEBAT, serta personal memory berbagi satu tool registry.' },
  { number: '03', title: 'Model freedom', text: 'Flaz sebagai default, dengan OpenAI, Anthropic, OpenRouter, Ollama, dan endpoint compatible.' },
  { number: '04', title: 'Agent interoperable', text: 'Codex, Claude Code, dan OpenCode mengakses kemampuan yang sama melalui MCP global.' }
];
---

<BaseLayout>
  <main id="main-content">
    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-content">
        <p class="signal"><span></span> PERSONAL LEARNING OS / ONLINE</p>
        <h1>Your knowledge.<br /><em>In one orbit.</em></h1>
        <p class="lead">Xninetzy menghubungkan WhatsApp, Obsidian, pembelajaran kampus, dan coding agents menjadi satu sistem AI yang tetap berada di bawah kendalimu.</p>
        <div class="hero-actions">
          <a class="primary" href="/docs/getting-started/">Mulai instalasi <Icon name="arrow" /></a>
          <a class="secondary" href="/docs/introduction/"><Icon name="book" /> Baca konsep</a>
        </div>
        <div class="status-line">
          <span><i></i> Local-first</span>
          <span>149 MCP tools</span>
          <span>6 LLM providers</span>
        </div>
      </div>
      <div class="orbit-visual" aria-label="Diagram orbit Xninetzy">
        <div class="core"><span>X</span><small>XNINETZY</small></div>
        <div class="orbit orbit-a"><span class="node node-wa">WA</span></div>
        <div class="orbit orbit-b"><span class="node node-obs">OBS</span></div>
        <div class="orbit orbit-c"><span class="node node-mcp">MCP</span></div>
        <span class="star s1">✦</span><span class="star s2">·</span><span class="star s3">✧</span>
      </div>
    </section>

    <section class="capability-strip" aria-label="Kemampuan utama">
      {capabilities.map((item) => (
        <article><span>{item.number}</span><h2>{item.title}</h2><p>{item.text}</p></article>
      ))}
    </section>

    <section class="section architecture">
      <div class="section-copy">
        <p class="kicker">ONE SYSTEM / CLEAR BOUNDARIES</p>
        <h2>From message<br />to meaningful action.</h2>
        <p>Pesan dirutekan oleh LangGraph ke jawaban langsung, workflow, atau tool. Aksi sensitif tetap berhenti di approval boundary.</p>
        <a href="/docs/architecture/">Pelajari arsitektur <Icon name="arrow" /></a>
      </div>
      <div class="flow-card">
        <div class="flow-node active"><small>INTERFACE</small><strong>WhatsApp / CLI</strong></div>
        <span class="flow-line"><i></i></span>
        <div class="flow-node"><small>ORCHESTRATION</small><strong>FastAPI + LangGraph</strong></div>
        <span class="flow-line"><i></i></span>
        <div class="flow-grid">
          <div class="flow-node"><small>KNOWLEDGE</small><strong>Obsidian / FAISS</strong></div>
          <div class="flow-node orange"><small>ACTIONS</small><strong>HEBAT / WA / HITL</strong></div>
        </div>
      </div>
    </section>

    <section class="section docs-index">
      <header>
        <div><p class="kicker">DOCUMENTATION MAP</p><h2>Pick your trajectory.</h2></div>
        <p>Mulai dari instalasi, lalu buka integrasi atau area operasional yang sedang kamu kerjakan.</p>
      </header>
      <div class="doc-groups">
        {navigation.map((group, groupIndex) => (
          <section>
            <div class="group-heading"><span>0{groupIndex + 1}</span><h3>{group.title}</h3></div>
            <div class="doc-links">
              {group.items.map((item) => (
                <a href={item.href}>
                  <span><strong>{item.title}</strong><small>{item.description}</small></span>
                  <Icon name="arrow" />
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="final-cta">
      <p class="kicker">EVENT HORIZON</p>
      <h2>Ready to connect<br />your second brain?</h2>
      <p>Siapkan environment, pilih provider, lalu hubungkan WhatsApp dan vault pertamamu.</p>
      <a href="/docs/getting-started/">Buka quick start <Icon name="arrow" /></a>
    </section>
  </main>
</BaseLayout>

<style>
  .hero { position: relative; width: min(92rem, 100%); min-height: 44rem; margin: auto; padding: clamp(5rem, 10vw, 9rem) 4rem 6rem; display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 4rem; overflow: hidden; }
  .hero-glow { position: absolute; right: -8rem; top: 2rem; width: 44rem; height: 44rem; border-radius: 50%; background: radial-gradient(circle, rgba(139,92,246,.17), rgba(99,102,241,.045) 38%, transparent 69%); filter: blur(2px); }
  .hero-content { position: relative; z-index: 2; }
  .signal, .kicker { color: var(--orange-bright); font: 500 .67rem var(--font-mono); letter-spacing: .15em; }
  .signal { display: flex; align-items: center; gap: .55rem; }
  .signal span { width: .45rem; height: .45rem; border-radius: 50%; background: #34d399; box-shadow: 0 0 10px #34d399; }
  h1 { margin: 1.15rem 0 1.4rem; font-size: clamp(3.6rem, 7.2vw, 7rem); line-height: .87; letter-spacing: -.075em; }
  h1 em { color: var(--purple-bright); font-style: normal; text-shadow: 0 0 42px rgba(168,85,247,.22); }
  .lead { max-width: 40rem; color: var(--muted); font-size: clamp(1rem, 1.5vw, 1.15rem); line-height: 1.78; }
  .hero-actions { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: .7rem; }
  .hero-actions a, .final-cta a { padding: .82rem 1rem; display: inline-flex; align-items: center; gap: .55rem; border-radius: .65rem; font-size: .82rem; font-weight: 700; text-decoration: none; }
  .primary, .final-cta a { color: #fff; background: linear-gradient(135deg, var(--purple), #6d28d9); box-shadow: 0 10px 30px rgba(109,40,217,.22); }
  .primary:hover, .final-cta a:hover { transform: translateY(-1px); box-shadow: 0 13px 38px rgba(109,40,217,.35); }
  .secondary { border: 1px solid var(--line); color: var(--lavender); background: rgba(255,255,255,.025); }
  .secondary:hover { border-color: var(--border-dim); background: rgba(139,92,246,.06); }
  .status-line { margin-top: 2.8rem; display: flex; flex-wrap: wrap; gap: 1.2rem; color: var(--dim); font: .64rem var(--font-mono); text-transform: uppercase; letter-spacing: .07em; }
  .status-line span { display: flex; align-items: center; gap: .4rem; }
  .status-line i { width: .35rem; height: .35rem; border-radius: 50%; background: #34d399; }
  .orbit-visual { position: relative; z-index: 1; aspect-ratio: 1; width: min(34rem, 100%); margin: auto; display: grid; place-items: center; }
  .core { position: absolute; z-index: 5; width: 7rem; height: 7rem; display: grid; place-items: center; border: 1px solid var(--border); border-radius: 50%; background: radial-gradient(circle at 35% 28%, #1c0b3d, #05010f 65%); box-shadow: 0 0 60px rgba(139,92,246,.3), inset 0 0 25px rgba(192,132,252,.11); }
  .core span { font: 800 2.5rem var(--font-mono); color: var(--purple-bright); }
  .core small { position: absolute; bottom: 1.25rem; color: var(--dim); font: .48rem var(--font-mono); letter-spacing: .13em; }
  .orbit { position: absolute; display: flex; align-items: center; border: 1px solid rgba(139,92,246,.22); border-radius: 50%; transform: rotate(-18deg); }
  .orbit::after { content: ''; position: absolute; left: 8%; top: 17%; width: .28rem; height: .28rem; border-radius: 50%; background: var(--purple-bright); box-shadow: 0 0 10px var(--purple); }
  .orbit-a { width: 14rem; height: 14rem; }
  .orbit-b { width: 22rem; height: 22rem; transform: rotate(28deg); border-color: rgba(99,102,241,.18); }
  .orbit-c { width: 31rem; height: 31rem; transform: rotate(-35deg); border-style: dashed; border-color: rgba(249,115,22,.14); }
  .node { position: absolute; right: -.95rem; padding: .35rem .45rem; border: 1px solid var(--line); border-radius: .35rem; color: var(--lavender); background: #07020e; font: .55rem var(--font-mono); transform: rotate(18deg); box-shadow: 0 5px 18px #000; }
  .orbit-b .node { transform: rotate(-28deg); color: #c7d2fe; }
  .orbit-c .node { transform: rotate(35deg); color: #fed7aa; border-color: rgba(249,115,22,.35); }
  .star { position: absolute; color: var(--dim); }
  .s1 { top: 10%; right: 18%; color: var(--purple-bright); }.s2 { bottom: 8%; left: 23%; }.s3 { top: 36%; left: 5%; color: var(--orange); }
  .capability-strip { border-block: 1px solid rgba(124,58,237,.2); display: grid; grid-template-columns: repeat(4,1fr); background: rgba(0,0,0,.28); }
  .capability-strip article { min-height: 14rem; padding: 2rem; border-right: 1px solid rgba(124,58,237,.16); }
  .capability-strip article:last-child { border: 0; }
  .capability-strip span { color: var(--orange); font: .64rem var(--font-mono); }
  .capability-strip h2 { margin: 2.3rem 0 .65rem; font-size: 1rem; }
  .capability-strip p { margin: 0; color: var(--dim); font-size: .77rem; line-height: 1.65; }
  .section { width: min(80rem, calc(100% - 3rem)); margin: auto; padding: 9rem 0; }
  .architecture { display: grid; grid-template-columns: .8fr 1.2fr; align-items: center; gap: 7rem; }
  .section-copy h2, .docs-index h2, .final-cta h2 { margin: .8rem 0 1.1rem; font-size: clamp(2.3rem, 4.8vw, 4.4rem); line-height: .98; letter-spacing: -.055em; }
  .section-copy > p:not(.kicker) { color: var(--muted); line-height: 1.75; }
  .section-copy > a { margin-top: 1.2rem; display: inline-flex; align-items: center; gap: .45rem; color: var(--purple-bright); font: .75rem var(--font-mono); text-decoration: none; }
  .flow-card { padding: 2rem; border: 1px solid var(--line); border-radius: 1rem; background: linear-gradient(145deg, rgba(139,92,246,.06), rgba(0,0,0,.3)); box-shadow: 0 25px 70px rgba(0,0,0,.3); }
  .flow-node { padding: 1.15rem 1.3rem; display: grid; gap: .35rem; border: 1px solid var(--line); border-radius: .65rem; background: #06020d; }
  .flow-node.active { border-color: rgba(139,92,246,.6); box-shadow: inset 3px 0 var(--purple); }
  .flow-node.orange { box-shadow: inset 3px 0 var(--orange); }
  .flow-node small { color: var(--dim); font: .58rem var(--font-mono); letter-spacing: .1em; }.flow-node strong { font-size: .88rem; }
  .flow-line { width: 1px; height: 2rem; margin: auto; display: block; background: var(--border-dim); }.flow-line i { width: .3rem; height: .3rem; display: block; border-radius: 50%; background: var(--purple-bright); transform: translate(-.13rem, .8rem); box-shadow: 0 0 7px var(--purple); }
  .flow-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem; }
  .docs-index { border-top: 1px solid var(--line); }
  .docs-index > header { display: grid; grid-template-columns: 1fr .65fr; align-items: end; gap: 4rem; }
  .docs-index > header > p { margin-bottom: 1.4rem; color: var(--muted); line-height: 1.7; }
  .doc-groups { margin-top: 4rem; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); }
  .doc-groups > section { padding: 2rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }.doc-groups > section:nth-child(2n) { border-right: 0; }
  .group-heading { display: flex; align-items: center; gap: .65rem; }.group-heading span { color: var(--orange); font: .62rem var(--font-mono); }.group-heading h3 { margin: 0; font-size: .92rem; }
  .doc-links { margin-top: 1.25rem; display: grid; }.doc-links a { padding: .85rem 0; display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid rgba(39,32,51,.75); text-decoration: none; }.doc-links a:hover strong { color: var(--purple-bright); }.doc-links a > span { display: grid; gap: .22rem; }.doc-links strong { font-size: .8rem; transition: color .18s ease; }.doc-links small { color: var(--dim); font-size: .68rem; }
  .final-cta { position: relative; padding: 9rem 2rem; overflow: hidden; border-top: 1px solid rgba(124,58,237,.23); text-align: center; background: radial-gradient(circle at 50% 100%, rgba(109,40,217,.18), transparent 45%); }
  .final-cta::before { content: ''; position: absolute; left: 50%; bottom: -28rem; width: 48rem; height: 48rem; border: 1px solid rgba(249,115,22,.25); border-radius: 50%; transform: translateX(-50%); box-shadow: 0 0 80px rgba(249,115,22,.07); }
  .final-cta h2, .final-cta p, .final-cta a { position: relative; }.final-cta > p:not(.kicker) { max-width: 35rem; margin: 0 auto 2rem; color: var(--muted); line-height: 1.7; }
  @media(max-width: 900px) { .hero { padding: 6rem 2rem 4rem; grid-template-columns: 1fr; }.orbit-visual { width: min(29rem, 94vw); }.capability-strip { grid-template-columns: 1fr 1fr; }.capability-strip article:nth-child(2) { border-right: 0; }.capability-strip article:nth-child(-n+2) { border-bottom: 1px solid rgba(124,58,237,.16); }.architecture { grid-template-columns: 1fr; gap: 3rem; }.docs-index > header { grid-template-columns: 1fr; gap: .2rem; } }
  @media(max-width: 600px) { .hero { min-height: auto; padding: 4.5rem 1.2rem 3rem; }.orbit-visual { transform: scale(.78); margin-block: -3rem; }.capability-strip { grid-template-columns: 1fr; }.capability-strip article { min-height: auto; border-right: 0; border-bottom: 1px solid rgba(124,58,237,.16); }.section { padding: 6rem 0; }.flow-card { padding: 1rem; }.flow-grid, .doc-groups { grid-template-columns: 1fr; }.doc-groups > section { padding: 1.5rem 0; border-right: 0; }.docs-index > header { gap: 0; }.final-cta { padding: 7rem 1.2rem; } }
</style>
