---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { navigation } from '../data/navigation';

const capabilities = [
  { number: '01', title: 'FastMCP server', text: 'FastMCP("xninetzy", stateless_http, json_response) over stdio with Streamable HTTP on loopback by default.' },
  { number: '02', title: 'Canonical registry', text: '343 tools classified by risk (read/draft/write/final), feature pack, and idempotency requirement.' },
  { number: '03', title: 'Idempotent writes', text: 'Every write and final tool carries an idempotency key. Replays return the original result, never a duplicate.' },
  { number: '04', title: 'Host-driven loop', text: 'Claude, Claude Code, Cursor, Codex, and OpenCode connect through the same registry. The MCP server exposes capability; the host decides what to do next.' }
];

const transports = [
  { label: 'stdio', detail: 'Primary transport. OS process boundary is the trust boundary. No network auth.' },
  { label: 'Streamable HTTP', detail: 'stateless_http + json_response, loopback (127.0.0.1) by default. Non-loopback warns and requires OAuth 2.1.' }
];

const registry = [
  { bucket: 'core', count: 259, detail: 'Obsidian, reminders, life OS, knowledge, Lightning, skills, security, automation, repo, vision, harness, improvement, memory.' },
  { bucket: 'academic-unair', count: 40, detail: 'HEBAT, Cyber Campus, UACC, QA Kuesioner, KRS War.' },
  { bucket: 'research', count: 37, detail: 'deep_research, web_evidence, pixelrag, research_search/fetch/compare/grade.' },
  { bucket: 'coding', count: 7, detail: 'coding-agent orchestration, harness routing, repo inspection.' }
];

const finalTools = [
  { name: 'hebat_upload_submission', note: 'Final HEBAT submission requires HITL approval.' },
  { name: 'portal_krs_war_arm', note: 'KRS War arming requires HITL approval.' },
  { name: 'qa_fill_kuesioner', note: 'QA Kuesioner submission requires HITL approval.' }
];
---

<BaseLayout>
  <main id="main-content">
    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="hero-content">
        <p class="signal"><span></span> MCP SYSTEM / ONLINE</p>
        <h1>FastMCP server.<br /><em>343 tools. One registry.</em></h1>
        <p class="lead">Xninetzy exposes a single MCP server to your host. stdio primary, Streamable HTTP loopback by default. The registry carries Obsidian, HEBAT, Cyber Campus, Lightning, Knowledge, Career, reminders, skills — every capability as an MCP tool.</p>
        <div class="hero-actions">
          <a class="primary" href="/docs/getting-started/">Start the MCP server <Icon name="arrow" /></a>
          <a class="secondary" href="/docs/mcp-system/"><Icon name="book" /> MCP reference</a>
        </div>
        <div class="status-line">
          <span><i></i> stdio primary</span>
          <span>Streamable HTTP loopback</span>
          <span>3 FINAL tools</span>
          <span>mcp 1.28.1</span>
        </div>
      </div>
      <div class="orbit-visual" aria-label="Xninetzy MCP orbit diagram">
        <div class="core"><span>M</span><small>FastMCP</small></div>
        <div class="orbit orbit-a"><span class="node node-stdio">stdio</span></div>
        <div class="orbit orbit-b"><span class="node node-http">http</span></div>
        <div class="orbit orbit-c"><span class="node node-reg">registry</span></div>
        <span class="star s1">✦</span><span class="star s2">·</span><span class="star s3">✧</span>
      </div>
    </section>

    <section class="capability-strip" aria-label="MCP capabilities">
      {capabilities.map((item) => (
        <article><span>{item.number}</span><h2>{item.title}</h2><p>{item.text}</p></article>
      ))}
    </section>

    <section class="section transport-grid">
      <header>
        <p class="kicker">TRANSPORTS</p>
        <h2>stdio primary, Streamable HTTP loopback.</h2>
      </header>
      <div class="grid">
        {transports.map((t) => (
          <article>
            <strong>{t.label}</strong>
            <p>{t.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section registry-grid">
      <header>
        <p class="kicker">REGISTRY</p>
        <h2>343 tools classified by feature pack.</h2>
      </header>
      <div class="grid">
        {registry.map((r) => (
          <article>
            <small>{r.bucket}</small>
            <strong>{r.count}</strong>
            <p>{r.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section final-card">
      <header>
        <p class="kicker">FINAL-CLASS</p>
        <h2>Three tools stop at the HITL gate.</h2>
        <p class="final-note">Every FINAL-class tool requires server-side HITL approval regardless of host-supplied tier. The CLI orchestrator enforces this via <code>_effective_tier = max(declared, manifest_tier)</code>.</p>
      </header>
      <ul>
        {finalTools.map((f) => (
          <li>
            <code>{f.name}</code>
            <span>{f.note}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="section docs-index">
      <header>
        <div><p class="kicker">DOCUMENTATION MAP</p><h2>Pick your trajectory.</h2></div>
        <p>Start with the MCP reference, then open the integration or operations area you are working on.</p>
      </header>
      <div class="doc-groups">
        {navigation.map((group, groupIndex) => (
          <section>
            <div class="group-heading"><span>0{groupIndex + 1}</span><h3>{group.title}</h3></div>
            <div class="doc-links">
              {group.items.map((item) => (
                <a href={item.href}>
                  <span><strong>{item.title}</strong><small>{item.description}</small></span>
                  <Icon name="arrow" />
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="final-cta">
      <p class="kicker">READY WHEN YOU ARE</p>
      <h2>Start the MCP server<br />and connect a host.</h2>
      <p>Run <code>uv run python -m xninetzy.cli.supervisor start</code> for stdio, or set <code>XNINETZY_MCP_TRANSPORT=streamable-http</code> for loopback HTTP.</p>
      <a href="/docs/getting-started/">Open quick start <Icon name="arrow" /></a>
      <p class="creator-links">Created by <a href="https://misbahul-muttaqin.vercel.app/" target="_blank" rel="noreferrer">Misbahul Muttaqin</a> · <a href="https://github.com/misbahul45" target="_blank" rel="noreferrer">GitHub</a></p>
    </section>
  </main>
</BaseLayout>

<style>
  .hero { position: relative; width: min(92rem, 100%); min-height: 44rem; margin: auto; padding: clamp(5rem, 10vw, 9rem) 4rem 6rem; display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: 4rem; overflow: hidden; }
  .hero-glow { position: absolute; right: -8rem; top: 2rem; width: 44rem; height: 44rem; border-radius: 50%; background: radial-gradient(circle, rgba(139,92,246,.17), rgba(99,102,241,.045) 38%, transparent 69%); filter: blur(2px); }
  .hero-content { position: relative; z-index: 2; }
  .signal, .kicker { color: var(--orange-bright); font: 500 .67rem var(--font-mono); letter-spacing: .15em; }
  .signal { display: flex; align-items: center; gap: .55rem; }
  .signal span { width: .45rem; height: .45rem; border-radius: 50%; background: #34d399; box-shadow: 0 0 10px #34d399; }
  h1 { margin: 1.15rem 0 1.4rem; font-size: clamp(3.6rem, 7.2vw, 7rem); line-height: .87; letter-spacing: -.075em; }
  h1 em { color: var(--purple-bright); font-style: normal; text-shadow: 0 0 42px rgba(168,85,247,.22); }
  .lead { max-width: 40rem; color: var(--muted); font-size: clamp(1rem, 1.5vw, 1.15rem); line-height: 1.78; }
  .hero-actions { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: .7rem; }
  .hero-actions a, .final-cta a { padding: .82rem 1rem; display: inline-flex; align-items: center; gap: .55rem; border-radius: .65rem; font-size: .82rem; font-weight: 700; text-decoration: none; }
  .primary, .final-cta a { color: #fff; background: linear-gradient(135deg, var(--purple), #6d28d9); box-shadow: 0 10px 30px rgba(109,40,217,.22); }
  .primary:hover, .final-cta a:hover { transform: translateY(-1px); box-shadow: 0 13px 38px rgba(109,40,217,.35); }
  .secondary { border: 1px solid var(--line); color: var(--lavender); background: rgba(255,255,255,.025); }
  .secondary:hover { border-color: var(--border-dim); background: rgba(139,92,246,.06); }
  .status-line { margin-top: 2.8rem; display: flex; flex-wrap: wrap; gap: 1.2rem; color: var(--dim); font: .64rem var(--font-mono); text-transform: uppercase; letter-spacing: .07em; }
  .status-line span { display: flex; align-items: center; gap: .4rem; }
  .status-line i { width: .35rem; height: .35rem; border-radius: 50%; background: #34d399; }
  .orbit-visual { position: relative; z-index: 1; aspect-ratio: 1; width: min(34rem, 100%); margin: auto; display: grid; place-items: center; }
  .core { position: absolute; z-index: 5; width: 7rem; height: 7rem; display: grid; place-items: center; border: 1px solid var(--border); border-radius: 50%; background: radial-gradient(circle at 35% 28%, #1c0b3d, #05010f 65%); box-shadow: 0 0 60px rgba(139,92,246,.3), inset 0 0 25px rgba(192,132,252,.11); }
  .core span { font: 800 2.5rem var(--font-mono); color: var(--purple-bright); }
  .core small { position: absolute; bottom: 1.25rem; color: var(--dim); font: .48rem var(--font-mono); letter-spacing: .13em; }
  .orbit { position: absolute; display: flex; align-items: center; border: 1px solid rgba(139,92,246,.22); border-radius: 50%; transform: rotate(-18deg); }
  .orbit::after { content: ''; position: absolute; left: 8%; top: 17%; width: .28rem; height: .28rem; border-radius: 50%; background: var(--purple-bright); box-shadow: 0 0 10px var(--purple); }
  .orbit-a { width: 14rem; height: 14rem; }
  .orbit-b { width: 22rem; height: 22rem; transform: rotate(28deg); border-color: rgba(99,102,241,.18); }
  .orbit-c { width: 31rem; height: 31rem; transform: rotate(-35deg); border-style: dashed; border-color: rgba(249,115,22,.14); }
  .node { position: absolute; right: -.95rem; padding: .35rem .45rem; border: 1px solid var(--line); border-radius: .35rem; color: var(--lavender); background: #07020e; font: .55rem var(--font-mono); transform: rotate(18deg); box-shadow: 0 5px 18px #000; }
  .orbit-b .node { transform: rotate(-28deg); color: #c7d2fe; }
  .orbit-c .node { transform: rotate(35deg); color: #fed7aa; border-color: rgba(249,115,22,.35); }
  .star { position: absolute; color: var(--dim); }
  .s1 { top: 10%; right: 18%; color: var(--purple-bright); }.s2 { bottom: 8%; left: 23%; }.s3 { top: 36%; left: 5%; color: var(--orange); }
  .capability-strip { border-block: 1px solid rgba(124,58,237,.2); display: grid; grid-template-columns: repeat(4,1fr); background: rgba(0,0,0,.28); }
  .capability-strip article { min-height: 14rem; padding: 2rem; border-right: 1px solid rgba(124,58,237,.16); }
  .capability-strip article:last-child { border: 0; }
  .capability-strip span { color: var(--orange); font: .64rem var(--font-mono); }
  .capability-strip h2 { margin: 2.3rem 0 .65rem; font-size: 1rem; }
  .capability-strip p { margin: 0; color: var(--dim); font-size: .77rem; line-height: 1.65; }
  .section { width: min(80rem, calc(100% - 3rem)); margin: auto; padding: 6rem 0; }
  .section > header { margin-bottom: 2.6rem; }
  .section h2 { margin: .55rem 0 1rem; font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1; letter-spacing: -.04em; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .grid article { padding: 1.4rem 1.5rem; border: 1px solid var(--line); border-radius: .9rem; background: linear-gradient(145deg, rgba(139,92,246,.05), rgba(0,0,0,.35)); }
  .grid strong { display: block; color: #fff; font: 700 1.4rem var(--font-mono); margin-top: .25rem; }
  .grid small { color: var(--orange-bright); font: 500 .6rem var(--font-mono); letter-spacing: .14em; text-transform: uppercase; }
  .grid p { margin: .5rem 0 0; color: var(--muted); font-size: .82rem; line-height: 1.6; }
  .transport-grid { border-block: 1px solid var(--line); }
  .registry-grid { background: rgba(0,0,0,.18); border-radius: 1.2rem; padding-inline: 2rem; }
  .final-card { padding-bottom: 7rem; }
  .final-card ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .final-card li { display: grid; grid-template-columns: minmax(18rem, auto) 1fr; align-items: baseline; gap: 1rem; padding: .85rem 1.1rem; border: 1px solid var(--line); border-radius: .7rem; background: rgba(0,0,0,.3); }
  .final-card code { color: var(--purple-bright); font: 600 .85rem var(--font-mono); }
  .final-card span { color: var(--muted); font-size: .82rem; }
  .final-note { max-width: 38rem; color: var(--muted); line-height: 1.7; }
  .final-note code { color: var(--orange-bright); background: rgba(249,115,22,.08); padding: .05rem .3rem; border-radius: .25rem; font: .78rem var(--font-mono); }
  .docs-index { border-top: 1px solid var(--line); padding-top: 7rem; }
  .docs-index > header { display: grid; grid-template-columns: 1fr .65fr; align-items: end; gap: 4rem; }
  .docs-index > header > p { margin-bottom: 1.4rem; color: var(--muted); line-height: 1.7; }
  .doc-groups { margin-top: 4rem; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); }
  .doc-groups > section { padding: 2rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }.doc-groups > section:nth-child(2n) { border-right: 0; }
  .group-heading { display: flex; align-items: center; gap: .65rem; }.group-heading span { color: var(--orange); font: .62rem var(--font-mono); }.group-heading h3 { margin: 0; font-size: .92rem; }
  .doc-links { margin-top: 1.25rem; display: grid; }.doc-links a { padding: .85rem 0; display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid rgba(39,32,51,.75); text-decoration: none; }.doc-links a:hover strong { color: var(--purple-bright); }.doc-links a > span { display: grid; gap: .22rem; }.doc-links strong { font-size: .8rem; transition: color .18s ease; }.doc-links small { color: var(--dim); font-size: .68rem; }
  .final-cta { position: relative; padding: 9rem 2rem; overflow: hidden; border-top: 1px solid rgba(124,58,237,.23); text-align: center; background: radial-gradient(circle at 50% 100%, rgba(109,40,217,.18), transparent 45%); }
  .final-cta::before { content: ''; position: absolute; left: 50%; bottom: -28rem; width: 48rem; height: 48rem; border: 1px solid rgba(249,115,22,.25); border-radius: 50%; transform: translateX(-50%); box-shadow: 0 0 80px rgba(249,115,22,.07); }
  .final-cta h2, .final-cta p, .final-cta a { position: relative; }
  .final-cta > p:not(.kicker) { max-width: 35rem; margin: 0 auto 2rem; color: var(--muted); line-height: 1.7; }
  .final-cta > p:not(.kicker) code { color: var(--orange-bright); background: rgba(249,115,22,.08); padding: .12rem .4rem; border-radius: .3rem; font: .78rem var(--font-mono); }
  .final-cta .creator-links { margin-top: 1.3rem; font: .68rem var(--font-mono); }
  .final-cta .creator-links a { padding: 0; color: var(--purple-bright); background: none; box-shadow: none; }
  @media(max-width: 900px) { .hero { padding: 6rem 2rem 4rem; grid-template-columns: 1fr; }.orbit-visual { width: min(29rem, 94vw); }.capability-strip { grid-template-columns: 1fr 1fr; }.capability-strip article:nth-child(2) { border-right: 0; }.capability-strip article:nth-child(-n+2) { border-bottom: 1px solid rgba(124,58,237,.16); }.grid { grid-template-columns: 1fr; }.docs-index > header { grid-template-columns: 1fr; gap: .2rem; }.final-card li { grid-template-columns: 1fr; } }
  @media(max-width: 600px) { .hero { min-height: auto; padding: 4.5rem 1.2rem 3rem; }.orbit-visual { transform: scale(.78); margin-block: -3rem; }.capability-strip { grid-template-columns: 1fr; }.capability-strip article { min-height: auto; border-right: 0; border-bottom: 1px solid rgba(124,58,237,.16); }.section { padding: 4rem 0; }.docs-index { padding-top: 5rem; }.doc-groups { grid-template-columns: 1fr; }.doc-groups > section { padding: 1.5rem 0; border-right: 0; }.docs-index > header { gap: 0; }.final-cta { padding: 7rem 1.2rem; } }
</style>
