# ============================================
# Xninetzy MCP — Environment Template
# ============================================
# Copy to `.env` and replace placeholders with real values.
# The `.env` file is gitignored and stays local.
#
# Convention
#   ~ expands at runtime via xninetzy.core.config.expand_path()
#   Container paths stay inside the image; host paths use the user's home
#   Directory layout (all env-driven — see AGENTS.md §3)
# ============================================


# ============================================
# LLM providers
# ============================================
FLAZ_API_KEY=
FLAZ_BASE_URL=https://ai.flaz.id/v1
FLAZ_MODEL=deepseek-v4-flash
FLAZ_TIMEOUT_SECONDS=120
FLAZ_MAX_RETRIES=2

LLM_DEFAULT_PROVIDER=flaz
LLM_ENABLED_PROVIDERS=flaz
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
FLAZ_MODELS=deepseek-v4-flash

# Optional providers. Enable only after configuring credential + model.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_MODELS=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MODELS=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_MODELS=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=
OLLAMA_MODELS=
GENERIC_OPENAI_API_KEY=
GENERIC_OPENAI_BASE_URL=
GENERIC_OPENAI_MODEL=
GENERIC_OPENAI_MODELS=


# ============================================
# Core runtime
# ============================================
BOT_NAME=Xninetzy AI
BOT_OWNER=Misbahul Muttaqin
APP_TIMEZONE=Asia/Jakarta
AI_API_HOST=0.0.0.0
AI_API_PORT=8000
AI_API_AUTH_REQUIRED=true
AI_API_KEY=
CHAT_HISTORY_LIMIT=20
AGENT_DEBUG_ENDPOINTS=false
SINGLE_OWNER_MODE=true
OWNER_PHONE_NUMBER=
OWNER_ALIAS=owner
# Comma-separated extra owner identifiers (e.g. numeric IDs, emails)
OWNER_ALLOWED_IDS=


# ============================================
# Local paths (all env-driven, ~ expands at runtime)
# ============================================
# SQLite + runtime state — XDG compliant
DATA_DIR=~/.local/share/xninetzy
SQLITE_PATH=~/.local/share/xninetzy/xninetzy.sqlite3
BACKUP_DIR=~/.local/share/xninetzy/backups
BACKUP_RETENTION=14

# AI-generated artifact paths (see AGENTS.md §3)
OUTPUT_DIR=~/Documents/xninetzy/output
GENERATED_DOCUMENTS_DIR=~/Documents/xninetzy/generated/documents
RESEARCH_OUTPUT_DIR=~/Documents/xninetzy/generated/research
UNTRACKED_OUTPUT_DIR=~/Documents/xninetzy/generated/untracked
ARTIFACT_ALLOWLIST=true

# Downloads — HEBAT course materials and any other fetched files
HEBAT_DOWNLOAD_DIR=~/Downloads
HEBAT_DATA_DIR=~/.local/share/xninetzy/hebat

# Obsidian vault — clearly separated from generated artifacts
OBSIDIAN_ENABLED=true
OBSIDIAN_VAULT_HOST_PATH=~/Documents/xninetzy-vault
OBSIDIAN_VAULT_PATH=/app/obsidian-vault
OBSIDIAN_ALLOW_WRITE=true
OBSIDIAN_ALLOW_DELETE=false
OBSIDIAN_BACKUP_BEFORE_WRITE=true
OBSIDIAN_MAX_FILE_SIZE_MB=20
OBSIDIAN_SEARCH_INDEX_MAX_FILES=2000
OBSIDIAN_FOLDERING_ENABLED=true
OBSIDIAN_CANONICAL_SCHEMA_VERSION=1
OBSIDIAN_ORGANIZE_MODE=hybrid
OBSIDIAN_REQUIRE_ORGANIZE_APPROVAL=true
OBSIDIAN_AUTO_REFRESH_MOC=true
OBSIDIAN_PERSIST_ACADEMIC_SENSITIVE=false
OBSIDIAN_LEGACY_PATH_COMPATIBILITY=true
OBSIDIAN_MIGRATION_BACKUP=true

# Vector + GraphRAG runtime state
VECTOR_DATA_DIR=~/.local/share/xninetzy/vector
GRAPH_VECTOR_DATA_DIR=~/.local/share/xninetzy/graph_vector
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
GRAPHRAG_V3_ENABLED=false

# Web analysis
WEB_ANALYSIS_ENABLED=true
WEB_ANALYSIS_DATA_DIR=~/.local/share/xninetzy/web-analysis
WEB_ANALYSIS_PROFILE_ID=local-owner
WEB_ANALYSIS_ENCRYPTION_KEY=
WEB_ANALYSIS_HEADLESS=true
WEB_ANALYSIS_AUTHENTICATED_CRAWL_ENABLED=false
WEB_ANALYSIS_DEFAULT_TTL_DAYS=14
WEB_ANALYSIS_MAX_PAGES=10
WEB_ANALYSIS_PORTAL_MAX_PAGES=48
WEB_ANALYSIS_DISCOVERY_MAX_DEPTH=2
WEB_ANALYSIS_MAX_VISUAL_CAPTURES=3
WEB_ANALYSIS_TIMEOUT_MS=30000
WEB_ANALYSIS_REQUEST_DELAY_SECONDS=2
WEB_ANALYSIS_LOCK_STALE_SECONDS=1800
WEB_ANALYSIS_MAX_ENCRYPTED_JSON_BYTES=5242880
WEB_ANALYSIS_BACKGROUND_ENABLED=true
WEB_ANALYSIS_BACKGROUND_INTERVAL_MINUTES=360
WEB_ANALYSIS_BACKGROUND_SITES=hebat,mahasiswa,qa
WEB_ANALYSIS_BACKGROUND_AUTHENTICATED=false
PIXELRAG_LOCAL_SERVE_ENABLED=false
PIXELRAG_LOCAL_SERVE_COMMAND=
PIXELRAG_LOCAL_API=http://127.0.0.1:30001


# ============================================
# Knowledge + RAG
# ============================================
KNOWLEDGE_ENABLED=true
VECTOR_STORE=faiss
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=5
RAG_AUTO_GROUND_ENABLED=true
RAG_MIN_EVIDENCE=1
RAG_MAX_CONTEXT_CHARS=6000


# ============================================
# MCP server
# ============================================
MCP_RUNTIME_MODE=auto
MCP_HOST_DATA_DIR=
MCP_HOST_SQLITE_PATH=
MCP_PRINCIPAL_ID=
MCP_PRINCIPAL_NAME=
MCP_DEFAULT_CHAT_ID=
MCP_SERVER_ENABLED=true
MCP_HOST=0.0.0.0
MCP_PORT=8081
XNINETZY_AI_URL=http://127.0.0.1:8000


# ============================================
# Academic portals (HEBAT, Cyber Campus, UACC, QA)
# ============================================
ACADEMIC_CREDENTIAL_SOURCE=hebat

# HEBAT
HEBAT_ENABLED=true
HEBAT_BASE_URL=https://hebat.elearning.unair.ac.id
HEBAT_LOGIN_URL=https://hebat.elearning.unair.ac.id/login/index.php
HEBAT_BROWSER_HEADLESS=true
HEBAT_ALLOW_AUTO_SUBMIT=true
HEBAT_REQUIRE_CONFIRMATION=true
HEBAT_MAX_UPLOAD_BYTES=5242880
HEBAT_SYNC_INTERVAL_MINUTES=60
HEBAT_REMINDER_BEFORE_HOURS=24,6,1
HEBAT_ALLOWED_FILE_TYPES=.pdf
HEBAT_RATE_LIMIT_SECONDS=2.0
HEBAT_USERNAME=
HEBAT_PASSWORD=
HEBAT_NOTIFY_CHAT_ID=
HEBAT_AUTO_LOGIN=false
HEBAT_PERIODIC_SYNC_ENABLED=false
HEBAT_SESSION_MAX_RELOGIN=4
HEBAT_DEBUG_SAVE_HTML=false
HEBAT_DEBUG_HTML_DIR=~/.local/share/xninetzy/hebat/debug-html

# Cyber Campus
CYBER_CAMPUS_ENABLED=true
CYBER_CAMPUS_CREDENTIAL_SOURCE=hebat
CYBER_CAMPUS_BASE_URL=https://mahasiswa.unair.ac.id
CYBER_CAMPUS_BROWSER_HEADLESS=true
CYBER_CAMPUS_LOGIN_CHALLENGE_TTL_SECONDS=180
CYBER_CAMPUS_LOGIN_MAX_ATTEMPTS=3
CYBER_CAMPUS_LOGIN_TIMEOUT_MS=30000
CYBER_CAMPUS_GRADE_TOKEN_TTL_SECONDS=180
CYBER_CAMPUS_GRADE_TOKEN_MAX_ATTEMPTS=3
CYBER_CAMPUS_ENTRY_YEAR=0
KRS_WATCHER_DEFAULT_INTERVAL_SECONDS=600
KRS_WATCHER_ANNOUNCEMENT_INTERVAL_SECONDS=30
KRS_WATCHER_WINDOW_INTERVAL_SECONDS=7

# UACC SSO (shares HEBAT credentials)
UACC_ENABLED=true
UACC_BASE_URL=https://uacc.unair.ac.id
UACC_CREDENTIAL_SOURCE=hebat
UACC_BROWSER_HEADLESS=true
UACC_LOGIN_CHALLENGE_TTL_SECONDS=600
UACC_LOGIN_MAX_ATTEMPTS=3
UACC_LOGIN_TIMEOUT_MS=30000


# ============================================
# External MCP registry (optional owner-managed)
# ============================================
EXTERNAL_MCP_ENABLED=false
EXTERNAL_MCP_ALLOW_CALLS=false
EXTERNAL_MCP_REGISTRY_PATH=~/.local/share/xninetzy/external-mcp.json
EXTERNAL_MCP_TIMEOUT_SECONDS=30
EXTERNAL_MCP_MAX_SERVERS=8


# ============================================
# Skills catalog
# ============================================
XNINETZY_SKILLS_DIR=~/.local/share/xninetzy/skills
XNINETZY_SKILL_MAX_BYTES=65536
XNINETZY_SKILL_RESOURCE_MAX_BYTES=131072
XNINETZY_SKILL_MAX_BODY_LINES=500
XNINETZY_SKILL_MATCH_THRESHOLD=4
XNINETZY_SKILL_AUTO_INJECT_LIMIT=2
XNINETZY_SKILL_AUTO_INJECT_MAX_CHARS=8000
XNINETZY_SKILL_ALLOW_BUILTIN_OVERRIDE=false
XNINETZY_SKILL_AUTO_INJECT_USER=false


# ============================================
# OCR + document parsing
# ============================================
OCR_ENABLED=true
OCR_LANGUAGES=eng+ind
OCR_MAX_PDF_PAGES=20
OCR_MAX_IMAGE_PIXELS=25000000


# ============================================
# Reminder + Life OS
# ============================================
REMINDER_ENABLED=true
REMINDER_POLL_INTERVAL_SECONDS=30
REMINDER_SCHEDULER_INTERVAL_SECONDS=30
REMINDER_EXPIRE_AFTER_HOURS=24
REMINDER_AUTO_CREATE_ENABLED=true
REMINDER_DEFAULT_TIMEZONE=Asia/Jakarta

LIFE_OS_ENABLED=true
DAILY_REVIEW_ENABLED=true
AUTO_APPEND_DAILY_NOTE=true

OS_SCHEDULER_ENABLED=true
OS_SCHEDULER_STARTUP_DELAY_SECONDS=30
OS_SCHEDULER_POLL_SECONDS=60
OS_JOB_LEASE_SECONDS=900
OS_JOB_RETRY_DELAY_SECONDS=300
OS_NOTIFY_CHAT_ID=
MORNING_BRIEFING_ENABLED=true
MORNING_BRIEFING_HOUR=7
EVENING_CHECKIN_ENABLED=true
EVENING_CHECKIN_HOUR=20
WEEKLY_REVIEW_ENABLED=true
WEEKLY_REVIEW_WEEKDAY=6
WEEKLY_REVIEW_HOUR=20


# ============================================
# Workflow orchestration
# ============================================
WORKFLOW_ENABLED=true
WORKFLOW_REQUIRE_CONFIRMATION=true
WORKFLOW_RUNNER_MODE=inline
WORKFLOW_NOTIFY_ENABLED=true
WORKFLOW_NOTIFY_ON_START=false
WORKFLOW_NOTIFY_ON_DONE=true
WORKFLOW_NOTIFY_MIN_INTERVAL_SECONDS=3
WORKFLOW_NOTIFY_MAX_MESSAGE_LENGTH=500
WORKFLOW_MAX_ACTIONS=12


# ============================================
# HITL approval gates
# ============================================
HITL_ENABLED=true
HITL_REQUIRE_FOR_RESEARCH_SAVE=true
HITL_REQUIRE_FOR_ROADMAP_ACTIVATION=true
HITL_REQUIRE_FOR_HEBAT_UPLOAD=true
HITL_REQUIRE_FOR_BULK_TASK_CREATE=true
HITL_REQUIRE_FOR_OBSIDIAN_WRITE=false
HITL_REQUIRE_FOR_GRAPH_RAG_WRITE=true


# ============================================
# Deep research
# ============================================
DEEP_RESEARCH_ADMIN_ONLY=true
DEEP_RESEARCH_ALLOW_GROUP_ADMINS=true
DEEP_RESEARCH_ALLOW_ADMIN_NAMES=true
DEEP_RESEARCH_MAX_CONCURRENT_PER_CHAT=2
XNINETZY_DEEP_RESEARCH_TIMEOUT_SECONDS=900


# ============================================
# General autonomy + safety
# ============================================
REQUIRE_CONFIRMATION_FOR_IMPORTANT_ACTIONS=true
ALLOW_AUTONOMOUS_UPLOAD=true
ALLOW_AUTONOMOUS_DELETE=false


# ============================================
# MCP call + streaming timeouts
# ============================================
XNINETZY_THINK_TIMEOUT_SECONDS=120
XNINETZY_INACTIVITY_TIMEOUT_SECONDS=60
XNINETZY_STREAM_TIMEOUT_SECONDS=300
XNINETZY_TOOL_TIMEOUT_SECONDS=180
XNINETZY_MCP_CONNECT_TIMEOUT_SECONDS=20
XNINETZY_MCP_CALL_TIMEOUT_SECONDS=180
XNINETZY_SLOW_REQUEST_WARNING_SECONDS=45


# ============================================
# Optional web research providers
# ============================================
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=
YOUTUBE_API_KEY=


# ============================================
# Source adapter credentials (optional)
# ============================================
# Each adapter falls back to graceful "no adapter" / "degraded health"
# when its credential is missing. Set only the ones you need.

# GitHub REST API (https://api.github.com)
# Free without token: 60 req/h. With token: 5000 req/h.
GITHUB_TOKEN=

# Reddit JSON endpoint
# A descriptive User-Agent is required by Reddit. Use your contact handle.
REDDIT_USER_AGENT=xninetzy-research/1.0 (contact: you@example.com)

# Hugging Face Hub (models, datasets, spaces)
HF_TOKEN=

# Semantic Scholar Graph API (optional key raises quota)
SEMANTIC_SCHOLAR_API_KEY=

# OpenStreetMap Nominatim (descriptive User-Agent required by ToS)
OSM_USER_AGENT=xninetzy-research/1.0

# NIST NVD CVE 2.0 (optional key raises quota)
NVD_API_KEY=

# BPS Indonesia Web API (registration required)
BPS_API_KEY=

# FRED (St Louis Fed) — free key from https://fredaccount.stlouisfed.org
FRED_API_KEY=

# Kaggle — KAGGLE_USERNAME + KAGGLE_KEY from https://www.kaggle.com/settings
KAGGLE_USERNAME=
KAGGLE_KEY=

# Langfuse observability (optional; leave blank to disable remote tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
