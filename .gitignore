# ============================================
# Xninetzy MCP — Root Gitignore
# ============================================

# ---------------------------
# Environment & secrets
# ---------------------------
.env
.env.*
!.env.example

.secrets/
**/.secrets/
*.pem
*.key
*.crt
*.p12
*.pfx

# ---------------------------
# Python — runtime, caches, build artifacts
# ---------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

.python-version

.venv/
venv/
env/
ENV/
**/.venv/
**/venv/

# uv caches
.uv-cache/
**/.uv-cache/

# boleh commit uv.lock untuk reproducible build
uv.lock

# pytest / mypy / ruff caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ---------------------------
# Node.js / TypeScript (apps/docs only)
# ---------------------------
node_modules/
**/node_modules/

dist/
**/dist/

build/
**/build/

.yarn/
.yarn-cache/
.npm/
.turbo/

.astro/
**/.astro/

*.tsbuildinfo

# Astro docs node-specific
apps/docs/dist/
apps/docs/node_modules/
apps/docs/.astro/

# ---------------------------
# AI-generated artifact paths (env-configurable)
# see xninetzy.core.config (GENERATED_DOCUMENTS_DIR, OUTPUT_DIR, etc.)
# keep defaults at the project root, never in git
# ---------------------------
generated/
**/generated/

research-output/
**/research-output/

untracked-output/
**/untracked-output/

# ---------------------------
# Runtime data directories
# ---------------------------
data/
**/data/

# Allow a non-secret README to live inside data/ if you commit one
!data/README.md

# ---------------------------
# Local caches (linter, formatter, tooling)
# ---------------------------
.cache/
.playwright/
.playwright-cli/
.xninetzy/checkpoints/*.tmp
.openclaude/
.codex/
.claude/

# ---------------------------
# OS / Editor
# ---------------------------
.DS_Store
Thumbs.db

.vscode/
!.vscode/extensions.json
!.vscode/settings.example.json

.idea/

# Editor swap / backup
*.swp
*.swo
*.bak
*.tmp

# Project-root directory literally named "~" (some editors create this)
~

# ---------------------------
# Logs
# ---------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------
# Database files (every install owns its own SQLite)
# ---------------------------
*.sqlite
*.sqlite3
*.db
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal

# ---------------------------
# WhatsApp / Baileys / CLI artifacts (legacy)
# Removed in MCP-only pivot; entries remain so a stale worktree
# never accidentally re-commits them.
# ---------------------------
auth_info_baileys/
**/auth_info_baileys/
creds.json
**/creds.json
sessions/
**/sessions/

# ---------------------------
# Docker / Compose
# ---------------------------
docker-compose.override.yml

# ---------------------------
# CI/CD generated / vendor
# ---------------------------
repomix-output.xml
**/repomix-output.xml

# ---------------------------
# Scratch / stray research files
# ---------------------------
abstract.json
article.json
*-headers.txt
sciencedirect.html
.backup/
