---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
---

<header class="site-header">
  <div class="header-inner">
    <button class="icon-button mobile-only" id="menu-open" aria-label="Open navigation" aria-controls="mobile-navigation">
      <Icon name="menu" />
    </button>
    <Brand />
    <div class="header-actions">
      <button class="search-trigger" id="search-open" aria-label="Search documentation">
        <Icon name="search" />
        <span>Search docs</span>
        <kbd>Ctrl K</kbd>
      </button>
      <a class="header-link" href="/docs/mcp/">MCP</a>
      <a class="header-link" href="https://misbahul-muttaqin.vercel.app/" target="_blank" rel="noreferrer">Portfolio</a>
      <a class="header-link header-github" href="https://github.com/misbahul45" target="_blank" rel="noreferrer" aria-label="Misbahul45 on GitHub"><Icon name="github" /></a>
      <a class="header-cta" href="/docs/getting-started/">Get started <Icon name="arrow" /></a>
    </div>
  </div>
</header>

<dialog id="search-dialog" aria-labelledby="search-title">
  <div class="search-panel">
    <div class="search-field">
      <Icon name="search" />
      <input id="search-input" type="search" placeholder="Search MCP tools, Obsidian, HEBAT, Cyber Campus…" autocomplete="off" />
      <button id="search-close" class="icon-button" aria-label="Close search"><Icon name="x" /></button>
    </div>
    <p id="search-title" class="search-hint">Quick navigation</p>
    <div id="search-results" class="search-results"></div>
    <p id="search-empty" class="search-empty" hidden>No matching pages.</p>
  </div>
</dialog>

<script>
  type Hit = { title: string; description: string; href: string; body: string };
  const dialog = document.querySelector<HTMLDialogElement>('#search-dialog');
  const input = document.querySelector<HTMLInputElement>('#search-input');
  const out = document.querySelector<HTMLElement>('#search-results');
  const empty = document.querySelector<HTMLElement>('#search-empty');

  let index: Hit[] = [];
  fetch('/search-index.json')
    .then((r) => (r.ok ? r.json() : Promise.reject(new Error(`status ${r.status}`))))
    .then((d: Hit[]) => { index = d; })
    .catch(() => { if (out) out.innerHTML = '<p class="search-empty">Index unavailable.</p>'; });

  const score = (q: string, text: string): number => {
    if (!text) return 0;
    const t = text.toLowerCase();
    const i = t.indexOf(q);
    if (i === -1) return 0;
    return 100 - Math.min(i, 90) + (q.length / Math.max(text.length, 1)) * 50;
  };

  const render = (q: string) => {
    if (!out) return;
    out.innerHTML = '';
    if (q.length < 2) { if (empty) empty.hidden = true; return; }
    const ranked = index
      .map((h) => ({ h, s: Math.max(score(q, h.title) * 3, score(q, h.description) * 2, score(q, h.body)) }))
      .filter((r) => r.s > 0)
      .sort((a, b) => b.s - a.s)
      .slice(0, 10);
    if (ranked.length === 0) { if (empty) empty.hidden = false; return; }
    if (empty) empty.hidden = true;
    const frag = document.createDocumentFragment();
    ranked.forEach(({ h }) => {
      const a = document.createElement('a');
      a.href = h.href;
      a.innerHTML = `<span><strong>${h.title}</strong></span><p>${h.description}</p>`;
      frag.appendChild(a);
    });
    out.appendChild(frag);
  };

  function openSearch() {
    dialog?.showModal();
    window.setTimeout(() => input?.focus(), 20);
  }
  function closeSearch() {
    dialog?.close();
    if (input) input.value = '';
    render('');
  }

  document.querySelector('#search-open')?.addEventListener('click', openSearch);
  document.querySelector('#search-close')?.addEventListener('click', closeSearch);
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) closeSearch(); });
  document.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      openSearch();
    }
  });
  input?.addEventListener('input', () => render((input.value || '').trim().toLowerCase()));
</script>
