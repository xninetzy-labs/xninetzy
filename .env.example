# Flaz OpenAI-compatible LLM provider
# Never commit the real API key. Put it only in the local .env file.
# Safe prompt: cd services/ai && uv run python scripts/configure_flaz.py
FLAZ_API_KEY=
FLAZ_BASE_URL=https://ai.flaz.id/v1
FLAZ_MODEL=deepseek-v4-pro
FLAZ_TIMEOUT_SECONDS=120
FLAZ_MAX_RETRIES=2
FLAZ_THINKING_ENABLED=false

# Host identity used by the AI container for shared data/vault ownership.
# Check with: id -u && id -g
HOST_UID=1000
HOST_GID=1000

# Chat provider registry (comma-separated allowlist)
LLM_DEFAULT_PROVIDER=flaz
LLM_ENABLED_PROVIDERS=flaz
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
FLAZ_MODELS=deepseek-v4-pro

# Optional providers. Enable a provider only after configuring its model and credential.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_MODELS=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MODELS=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_MODELS=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=
OLLAMA_MODELS=
GENERIC_OPENAI_API_KEY=
GENERIC_OPENAI_BASE_URL=
GENERIC_OPENAI_MODEL=
GENERIC_OPENAI_MODELS=

# Local coding agents execute on the host through the loopback bridge. The AI
# container only sends an authenticated task and receives bounded output.
CODING_AGENT_ENABLED=true
CODING_AGENT_DEFAULT=opencode
CODING_AGENT_ALLOWED=internal,codex,claude-code,opencode,gemini,qwen,kilo
CODING_AGENT_ADMIN_ONLY=true
CODING_AGENT_EXECUTION_MODE=host_bridge
CODING_AGENT_WORKSPACE=/app/xninetzy
CODING_AGENT_ALLOWED_ROOT=/app/xninetzy
CODING_AGENT_HOST_BRIDGE_URL=http://host.docker.internal:8765
CODING_AGENT_HOST_BRIDGE_TOKEN=
CODING_AGENT_HOST_BRIDGE_TIMEOUT_SECONDS=660
CODING_AGENT_HOST_WORKSPACE=.
CODING_AGENT_HOST_ALLOWED_ROOT=.
CODING_AGENT_TIMEOUT_SECONDS=600
CODING_AGENT_MAX_OUTPUT_CHARS=12000
CODING_AGENT_SANDBOX=workspace-write
CODING_AGENT_REQUIRE_XNINETZY_MCP=true
CODING_AGENT_MCP_SERVER_NAME=xninetzy
CODING_AGENT_MCP_PREFLIGHT_TIMEOUT_SECONDS=15
# Only these host variables are inherited by coding-agent subprocesses.
# Add a credential variable only when the selected CLI cannot use its own login store.
CODING_AGENT_ENV_ALLOWLIST=PATH,HOME,USER,LOGNAME,LANG,LC_ALL,TERM,TMPDIR,XDG_CONFIG_HOME,XDG_DATA_HOME,XDG_CACHE_HOME,SSL_CERT_FILE,SSL_CERT_DIR,CODEX_HOME
CODEX_BIN=codex
CODEX_MODEL=
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_MODEL=
OPENCODE_BIN=opencode
OPENCODE_MODEL=
GEMINI_BIN=gemini
GEMINI_MODEL=
QWEN_BIN=qwen
QWEN_MODEL=
KILO_BIN=kilo
KILO_MODEL=

# Read-only fallback for ordinary WhatsApp chat when LangGraph fails.
CHAT_FAILOVER_ENABLED=true
CHAT_FAILOVER_RUNTIME=opencode
CHAT_FAILOVER_MODEL=
CHAT_FAILOVER_TIMEOUT_SECONDS=120
CHAT_FAILOVER_MAX_OUTPUT_CHARS=8000
CHAT_FAILOVER_SHOW_NOTICE=true
CHAT_FAILOVER_WHATSAPP_ONLY=true
CHAT_FAILOVER_MCP_PREFLIGHT_TIMEOUT_SECONDS=20

# Agent Skills catalog. Built-ins live in services/ai/.agents/skills; user skills
# are hot-discovered from this runtime directory without code changes.
XNINETZY_SKILLS_DIR=
XNINETZY_SKILL_MAX_BYTES=65536
XNINETZY_SKILL_RESOURCE_MAX_BYTES=131072
XNINETZY_SKILL_MAX_BODY_LINES=500
XNINETZY_SKILL_MATCH_THRESHOLD=4
XNINETZY_SKILL_AUTO_INJECT_LIMIT=2
XNINETZY_SKILL_AUTO_INJECT_MAX_CHARS=8000
XNINETZY_SKILL_ALLOW_BUILTIN_OVERRIDE=false
XNINETZY_SKILL_AUTO_INJECT_USER=false

# AI FastAPI
AI_API_HOST=0.0.0.0
AI_API_PORT=8000
# Required for WA engine, CLI, reminders API, and debug API.
AI_API_KEY=
AI_API_AUTH_REQUIRED=true
AGENT_MAX_ITERATIONS=10
CHAT_HISTORY_LIMIT=20
AGENT_DEBUG_ENDPOINTS=false
SINGLE_OWNER_MODE=true
# Required for a personal installation. Use an international WhatsApp number, for example 62812xxxx.
# Xninetzy normalizes it to the canonical WhatsApp JID for API, MCP, CLI, and WhatsApp authorization.
OWNER_PHONE_NUMBER=
OWNER_ALIAS=owner
# Optional comma-separated extra owner identities, including a Baileys @lid ID.
OWNER_ALLOWED_JIDS=
DATA_DIR=/app/data
SQLITE_PATH=/app/data/xninetzy.sqlite3
BACKUP_DIR=/app/data/backups
BACKUP_RETENTION=14

# Standard Xninetzy MCP runtime (Codex / Claude Code / OpenCode)
# auto keeps /app paths in Docker and maps them to services/ai/data on the host.
MCP_RUNTIME_MODE=auto
# Optional absolute host overrides; leave blank for repository defaults.
MCP_HOST_DATA_DIR=
MCP_HOST_SQLITE_PATH=
# Optional trusted owner identity for local MCP clients. Blank values fall back
# to ADMIN_JID, BOT_OWNER, and a stable local-owner namespace.
MCP_PRINCIPAL_ID=
MCP_PRINCIPAL_NAME=
MCP_DEFAULT_CHAT_ID=

# Optional owner-managed external MCP registry. The registry stores commands and
# environment variable names only; put token values in this .env file.
EXTERNAL_MCP_ENABLED=false
EXTERNAL_MCP_ALLOW_CALLS=false
EXTERNAL_MCP_REGISTRY_PATH=/app/data/external-mcp.json
EXTERNAL_MCP_TIMEOUT_SECONDS=30
EXTERNAL_MCP_MAX_SERVERS=8

# OCR for WhatsApp images and scanned PDFs
OCR_ENABLED=true
OCR_LANGUAGES=eng+ind
OCR_MAX_PDF_PAGES=20
OCR_MAX_IMAGE_PIXELS=25000000

# Local Web Analysis: one owner profile per installation, no cloud/multi-tenant service.
WEB_ANALYSIS_ENABLED=true
WEB_ANALYSIS_DATA_DIR=/app/data/web-analysis
WEB_ANALYSIS_PROFILE_ID=local-owner
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEB_ANALYSIS_ENCRYPTION_KEY=
WEB_ANALYSIS_HEADLESS=true
# Enable only after manual headed-browser login has saved an encrypted session.
WEB_ANALYSIS_AUTHENTICATED_CRAWL_ENABLED=false
WEB_ANALYSIS_DEFAULT_TTL_DAYS=14
WEB_ANALYSIS_MAX_PAGES=10
WEB_ANALYSIS_PORTAL_MAX_PAGES=48
WEB_ANALYSIS_DISCOVERY_MAX_DEPTH=2
WEB_ANALYSIS_MAX_VISUAL_CAPTURES=3
WEB_ANALYSIS_TIMEOUT_MS=30000
WEB_ANALYSIS_REQUEST_DELAY_SECONDS=2
WEB_ANALYSIS_LOCK_STALE_SECONDS=1800
WEB_ANALYSIS_MAX_ENCRYPTED_JSON_BYTES=5242880
WEB_ANALYSIS_BACKGROUND_ENABLED=true
WEB_ANALYSIS_BACKGROUND_INTERVAL_MINUTES=360
WEB_ANALYSIS_BACKGROUND_SITES=hebat,mahasiswa,qa
WEB_ANALYSIS_BACKGROUND_AUTHENTICATED=false
PIXELRAG_LOCAL_SERVE_ENABLED=false
PIXELRAG_LOCAL_SERVE_COMMAND=
PIXELRAG_LOCAL_API=http://127.0.0.1:30001
# One deployment-scoped account is reused by HEBAT, QA, and Cyber Campus.
ACADEMIC_CREDENTIAL_SOURCE=hebat
CYBER_CAMPUS_ENABLED=false
CYBER_CAMPUS_BASE_URL=https://mahasiswa.unair.ac.id
CYBER_CAMPUS_CREDENTIAL_SOURCE=hebat
CYBER_CAMPUS_BROWSER_HEADLESS=true
CYBER_CAMPUS_LOGIN_CHALLENGE_TTL_SECONDS=180
CYBER_CAMPUS_LOGIN_MAX_ATTEMPTS=3
CYBER_CAMPUS_LOGIN_TIMEOUT_MS=30000
CYBER_CAMPUS_GRADE_TOKEN_TTL_SECONDS=180
CYBER_CAMPUS_GRADE_TOKEN_MAX_ATTEMPTS=3
CYBER_CAMPUS_ENTRY_YEAR=0
# UACC SSO (uacc.unair.ac.id/mhs) memakai akun bersama HEBAT juga.
UACC_ENABLED=false
UACC_BASE_URL=https://uacc.unair.ac.id
UACC_CREDENTIAL_SOURCE=hebat
UACC_BROWSER_HEADLESS=true
UACC_LOGIN_CHALLENGE_TTL_SECONDS=600
UACC_LOGIN_MAX_ATTEMPTS=3
UACC_LOGIN_TIMEOUT_MS=30000
KRS_WATCHER_DEFAULT_INTERVAL_SECONDS=600
KRS_WATCHER_ANNOUNCEMENT_INTERVAL_SECONDS=30
KRS_WATCHER_WINDOW_INTERVAL_SECONDS=7

# Skills
SKILLS_ENABLED=true
SKILL_DEBUG_ENDPOINTS=true

# Obsidian
OBSIDIAN_ENABLED=true
OBSIDIAN_VAULT_HOST_PATH=/absolute/path/to/obsidian-vault
OBSIDIAN_VAULT_PATH=/app/obsidian-vault
OBSIDIAN_ALLOW_WRITE=true
OBSIDIAN_ALLOW_DELETE=false
OBSIDIAN_BACKUP_BEFORE_WRITE=true
OBSIDIAN_MAX_FILE_SIZE_MB=5
OBSIDIAN_SEARCH_INDEX_MAX_FILES=2000
OBSIDIAN_FOLDERING_ENABLED=true
OBSIDIAN_CANONICAL_SCHEMA_VERSION=1
OBSIDIAN_ORGANIZE_MODE=hybrid
OBSIDIAN_REQUIRE_ORGANIZE_APPROVAL=true
OBSIDIAN_AUTO_REFRESH_MOC=true
OBSIDIAN_PERSIST_ACADEMIC_SENSITIVE=false
OBSIDIAN_LEGACY_PATH_COMPATIBILITY=true
OBSIDIAN_MIGRATION_BACKUP=true

# Reminder
REMINDER_ENABLED=true
APP_TIMEZONE=Asia/Jakarta
REMINDER_POLL_INTERVAL_SECONDS=30
REMINDER_SCHEDULER_INTERVAL_SECONDS=30
REMINDER_EXPIRE_AFTER_HOURS=24
REMINDER_AUTO_CREATE_ENABLED=true
REMINDER_DEFAULT_TIMEZONE=Asia/Jakarta
WA_MCP_BASE_URL=http://127.0.0.1:8081
WA_MCP_API_KEY=

# CAPTCHA delivery (UACC / Cyber Campus): WhatsApp preferred, MCP image fallback
XNINETZY_CAPTCHA_WA_PREFERRED=true
XNINETZY_CAPTCHA_AUTO_OPEN=true
XNINETZY_CAPTCHA_DIR=/tmp/opencode
XNINETZY_CAPTCHA_WA_TIMEOUT_SECONDS=8.0

# Durable Personal OS schedules (hours use APP_TIMEZONE, weekday 0=Monday)
OS_SCHEDULER_ENABLED=true
OS_SCHEDULER_STARTUP_DELAY_SECONDS=30
OS_SCHEDULER_POLL_SECONDS=60
OS_JOB_LEASE_SECONDS=900
OS_JOB_RETRY_DELAY_SECONDS=300
# Optional delivery target; falls back to HEBAT_NOTIFY_CHAT_ID then ADMIN_JID.
OS_NOTIFY_CHAT_ID=
MORNING_BRIEFING_ENABLED=true
MORNING_BRIEFING_HOUR=7
EVENING_CHECKIN_ENABLED=true
EVENING_CHECKIN_HOUR=20
WEEKLY_REVIEW_ENABLED=true
WEEKLY_REVIEW_WEEKDAY=6
WEEKLY_REVIEW_HOUR=20
# Pengingat sholat harian (format: label:HH:MM,label:HH:MM)
PRAYER_REMINDER_ENABLED=true
PRAYER_REMINDER_SCHEDULE=subuh:04:30,dzuhur:11:45,ashar:15:00,maghrib:17:30,isya:18:40
# Disabled by default because it opens the authenticated Moodle session.
HEBAT_PERIODIC_SYNC_ENABLED=false

# Workflow
WORKFLOW_ENABLED=true
WORKFLOW_REQUIRE_CONFIRMATION=true
WORKFLOW_RUNNER_MODE=inline
WORKFLOW_NOTIFY_ENABLED=true
WORKFLOW_NOTIFY_ON_START=false
WORKFLOW_NOTIFY_ON_DONE=true
WORKFLOW_NOTIFY_MIN_INTERVAL_SECONDS=3
WORKFLOW_NOTIFY_MAX_MESSAGE_LENGTH=500
WORKFLOW_MAX_ACTIONS=12

# WhatsApp Worker
WA_AUTH_DIR=/app/sessions
WA_SESSION_DIR=/app/sessions
WA_LOGIN_MODE=qr
WA_PHONE_NUMBER=
WA_CONNECT_TIMEOUT_MS=60000
WA_QUERY_TIMEOUT_MS=60000
WA_KEEP_ALIVE_INTERVAL_MS=30000
WA_PAIRING_WAIT_MS=90000
WA_PAIRING_RECONNECT_DELAY_MS=30000
WA_GROUP_TRIGGER_MODE=mention_or_prefix
WA_COMMAND_PREFIX=!
WA_GROUP_ALLOW_ALL=false
WA_GROUP_TREAT_ANY_MENTION_AS_BOT=true
WA_LOG_LEVEL=debug
WA_BAILEYS_LOG_LEVEL=warn
WA_MEDIA_DIR=/app/data/wa-media
WA_MEDIA_MAX_BYTES=26214400
WA_PROCESSING_DIR=/app/sessions/processing
WA_MESSAGE_LEASE_MS=300000
WA_MESSAGE_RETRY_DELAY_MS=60000
WA_MESSAGE_RETENTION=5000
WA_STARTUP_MENU_ENABLED=true
WA_STARTUP_MENU_DELAY_MS=1500
AI_BASE_URL=http://127.0.0.1:8000
AI_CHAT_ENDPOINT=/api/chat
AI_TIMEOUT_MS=120000
AI_API_URL=http://127.0.0.1:8000

# Terminal client
XNINETZY_AI_URL=http://127.0.0.1:8000
XNINETZY_CLI_CHAT_ID=xninetzy-cli
# Leave sender ID blank to inherit OWNER_PHONE_NUMBER for the trusted local CLI identity.
XNINETZY_CLI_SENDER_ID=
XNINETZY_CLI_SENDER_NAME=Local Owner
XNINETZY_CLI_TIMEOUT_MS=120000
XNINETZY_THINK_TIMEOUT_SECONDS=120
XNINETZY_INACTIVITY_TIMEOUT_SECONDS=60
XNINETZY_TOOL_TIMEOUT_SECONDS=180
XNINETZY_MCP_CONNECT_TIMEOUT_SECONDS=20
XNINETZY_MCP_CALL_TIMEOUT_SECONDS=180
XNINETZY_DEEP_RESEARCH_TIMEOUT_SECONDS=900
XNINETZY_STREAM_TIMEOUT_SECONDS=300
XNINETZY_SLOW_REQUEST_WARNING_SECONDS=45
MCP_SERVER_ENABLED=true
MCP_HOST=0.0.0.0
MCP_PORT=8081
MCP_API_KEY=

# Bot Identity
BOT_NAME=Xninetzy AI
BOT_OWNER=Your Name

# Admin / Deep Research
ADMIN_JID=
ADMIN_NAMES=your_name
DEEP_RESEARCH_ADMIN_ONLY=true
DEEP_RESEARCH_ALLOW_GROUP_ADMINS=true
DEEP_RESEARCH_ALLOW_ADMIN_NAMES=true
DEEP_RESEARCH_MAX_CONCURRENT_PER_CHAT=2
DEEP_RESEARCH_MAX_SOURCES=40
DEEP_RESEARCH_MAX_QUERIES=24
DEEP_RESEARCH_TIMEOUT_SECONDS=180

# HITL Approval
HITL_ENABLED=true
HITL_REQUIRE_FOR_RESEARCH_SAVE=true
HITL_REQUIRE_FOR_ROADMAP_ACTIVATION=true
HITL_REQUIRE_FOR_HEBAT_UPLOAD=true
HITL_REQUIRE_FOR_BULK_TASK_CREATE=true
HITL_REQUIRE_FOR_OBSIDIAN_WRITE=false
HITL_REQUIRE_FOR_GRAPH_RAG_WRITE=true
ACTION_POLICY_DEFAULT_MODE=approval
ACTION_POLICY_OVERRIDES=
ACTION_POLICY_TTL_SECONDS=300
ACTION_POLICY_MAX_WRITES_PER_RUN=30
ACTION_POLICY_KILL_SWITCH=false
# Lightning reinforcement learning and contextual bandit
LIGHTNING_ENABLED=true
LIGHTNING_REVIEW_ENABLED=false
LIGHTNING_REVIEW_HOUR=2
LIGHTNING_REVIEW_INTERVAL_HOURS=24
LIGHTNING_AUTO_APPLY=false
LIGHTNING_CODE_FIX_ENABLED=false
LIGHTNING_PROVIDER_OPTIMIZATION_ENABLED=true
LIGHTNING_EXPLORATION_RATE=0.10
LIGHTNING_MIN_SAMPLES_PER_STRATEGY=20
LIGHTNING_EVALUATION_WINDOW_DAYS=7
LIGHTNING_RETENTION_DAYS=90
LIGHTNING_MAX_EVENT_CHARS=4000

# HEBAT / E-Learning UNAIR
HEBAT_BASE_URL=https://hebat.elearning.unair.ac.id
HEBAT_LOGIN_URL=https://hebat.elearning.unair.ac.id/login/index.php
HEBAT_DATA_DIR=/app/data/hebat
HEBAT_DOWNLOAD_DIR=/app/data/hebat/downloads
HEBAT_BROWSER_HEADLESS=true
HEBAT_ALLOW_AUTO_SUBMIT=false
HEBAT_REQUIRE_CONFIRMATION=true
HEBAT_MAX_UPLOAD_BYTES=5242880
HEBAT_SYNC_INTERVAL_MINUTES=60
HEBAT_REMINDER_BEFORE_HOURS=24,6,1
HEBAT_ALLOWED_FILE_TYPES=.pdf
HEBAT_RATE_LIMIT_SECONDS=2.0
HEBAT_USERNAME=
HEBAT_PASSWORD=
QA_CREDENTIAL_SOURCE=hebat
QA_BROWSER_HEADLESS=false
QA_RECAPTCHA_SETTLE_MS=3000
HEBAT_NOTIFY_CHAT_ID=
HEBAT_AUTO_LOGIN=false
HEBAT_SESSION_MAX_RELOGIN=2
HEBAT_DEBUG_SAVE_HTML=false
HEBAT_DEBUG_HTML_DIR=/app/data/hebat/debug-html

# Knowledge and retrieval
KNOWLEDGE_ENABLED=true
VECTOR_STORE=faiss
VECTOR_DATA_DIR=/app/data/vector
GRAPH_VECTOR_DATA_DIR=/app/data/graph_vector
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Public Hugging Face models load locally and do not require a token.
RAG_TOP_K=5
RAG_AUTO_GROUND_ENABLED=true
RAG_MIN_EVIDENCE=1
RAG_MAX_CONTEXT_CHARS=6000

# CPU-only AI runtime
# Xninetzy runs all inference on CPU. Do not set these to a GPU device — the
# service refuses to boot a CUDA build (app.xninetzy.runtime.cpu_guard).
XNINETZY_DEVICE=cpu
EMBEDDING_DEVICE=cpu
EMBEDDING_BACKEND=torch
EMBEDDING_NORMALIZE=true
EMBEDDING_BATCH_SIZE=16
CUDA_VISIBLE_DEVICES=
NVIDIA_VISIBLE_DEVICES=void
AI_CPU_THREADS=4
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
TORCH_NUM_THREADS=4
TOKENIZERS_PARALLELISM=false
UV_HTTP_TIMEOUT=120
UV_HTTP_RETRIES=5

# Optional Graph RAG
NEO4J_ENABLED=false
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# Host MCP runs outside the compose network, so bolt://neo4j:7687 is
# unreachable from the host. Host runtime swaps to the published loopback port
# below, and (when autostart is on) boots the `graph` compose profile on first
# graph access, then stops the container after it goes idle.
NEO4J_HOST_URI=bolt://127.0.0.1:7687
NEO4J_AUTOSTART_ENABLED=true
NEO4J_AUTOSTART_COMPOSE_SERVICE=neo4j
NEO4J_AUTOSTART_PROFILE=graph
NEO4J_AUTOSTART_BOOT_TIMEOUT_SECONDS=60
NEO4J_AUTOSTART_READINESS_TIMEOUT_SECONDS=10
NEO4J_AUTOSTART_COMMAND_TIMEOUT_SECONDS=8
NEO4J_CONNECT_TIMEOUT_SECONDS=3
NEO4J_FAILURE_COOLDOWN_SECONDS=60
NEO4J_AUTOSTART_IDLE_STOP_SECONDS=300
NEO4J_AUTOSTART_STOP_ON_EXIT=true

# External research
# Leave paid keys blank to use the configured open-source or local fallback.
WEB_SEARCH_PROVIDER=hybrid
TAVILY_API_KEY=
SERPER_API_KEY=
YOUTUBE_API_KEY=
SEARXNG_BASE_URL=
RESEARCH_PROVIDER_TIMEOUT_SECONDS=15
DEEP_RESEARCH_FETCH_FULLTEXT=true
DEEP_RESEARCH_FULLTEXT_CONCURRENCY=3

# Life OS and global safety
LIFE_OS_ENABLED=true
DAILY_REVIEW_ENABLED=true
AUTO_APPEND_DAILY_NOTE=true
REQUIRE_CONFIRMATION_FOR_IMPORTANT_ACTIONS=true
ALLOW_AUTONOMOUS_UPLOAD=false
ALLOW_AUTONOMOUS_DELETE=false
